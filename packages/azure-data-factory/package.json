    "monitoring"
  ],
  "author": "Klemens Stelk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klemensms/mcp-consultant-tools.git",
    "directory": "packages/azure-data-factory"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@azure/msal-node": "^3.3.0",
    "@mcp-consultant-tools/core": "33.0.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.8.3",
    "commander": "^14.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
