{
  "name": "@mcp-consultant-tools/azure-data-factory",
  "version": "35.0.0-beta.1",
  "description": "MCP server for Azure Data Factory - pipeline execution, monitoring, and error debugging",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
