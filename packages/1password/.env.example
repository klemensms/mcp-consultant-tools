# 1Password MCP Server Configuration
#
# AUTH MODE (auto-detected):
# - If OP_SERVICE_ACCOUNT_TOKEN is set → SDK mode (Service Account)
# - If OP_SERVICE_ACCOUNT_TOKEN is NOT set → CLI mode (desktop app integration)
#
# CLI mode requires:
#   1. 1Password CLI installed: brew install --cask 1password-cli
#   2. 1Password desktop app running and unlocked
#   3. "Integrate with 1Password CLI" enabled in Settings → Developer
#
# CLI mode advantages:
#   - No Service Account setup needed
#   - Uses existing user session (biometric auth)
#   - Full access to all vaults the user can see
#   - No API limits (runs locally)

# Service Account token (OPTIONAL — only needed for SDK mode)
# Get from: https://my.1password.com/developer-tools/infrastructure-secrets/serviceaccount/
# OP_SERVICE_ACCOUNT_TOKEN=

# Vault access control (works in both modes)
# Comma-separated vault names or IDs. Use * for all accessible vaults.
OP_ALLOWED_VAULTS=*

# Feature flags (works in both modes)
OP_ENABLE_WRITE=false       # Enable create/update/archive operations
OP_ENABLE_DELETE=false      # Enable delete operations
OP_ENABLE_VAULT_ADMIN=false # Enable vault permission management
