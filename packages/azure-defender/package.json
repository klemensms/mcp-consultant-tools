{
  "name": "@mcp-consultant-tools/azure-defender",
  "version": "35.0.0-beta.1",
  "description": "MCP server for Microsoft Defender for Cloud - secure score, security assessments, regulatory compliance, and attack paths",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "defender",
    "defender-for-cloud",
    "security",
    "compliance",
    "secure-score",
    "attack-path"
  ],
  "author": "Michal Sobieraj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klemensms/mcp-consultant-tools.git",
    "directory": "packages/azure-defender"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@mcp-consultant-tools/core": "34.0.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.8.3",
    "commander": "^14.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "bin": {
    "mcp-defender": "build/index.js",
    "mcp-defender-cli": "build/cli.js"
  }
}
