# ─── Audit subsystem ──────────────────────────────────────────
# REQUIRED. No default. Breaking change in v32+.
# off  = no audit (dev only; refuse-to-start in production)
# lean = metadata + redaction counts only
# full = same as lean + post-redaction tool input + response body
MCP_AUDIT_LEVEL=

# REQUIRED when MCP_AUDIT_LEVEL is lean or full.
# Free-text client identifier (e.g. Acme, Contoso, MCPTest).
MCP_AUDIT_CLIENT=

# Recommended. The directory identity for this operator.
# When unset, the audit subsystem captures os-username@hostname as a fallback.
MCP_AUDIT_OPERATOR=

# Optional. Override base directory for audit files.
# Default: ~/.mcp-audit/{client}/
# MCP_AUDIT_PATH=

# Optional. Rotation strategy: monthly (default), weekly, daily, or size:<N>MB.
# MCP_AUDIT_ROTATION=monthly

# REQUIRED. Tells the refuse-to-start matrix which env this is.
# production | uat | dev
MCP_ENVIRONMENT_TYPE=
