{
  "name": "@mcp-consultant-tools/code-review",
  "version": "35.0.0-beta.4",
  "description": "MCP server for provider-agnostic repository code review - .NET framework EOL scanning, NuGet package auditing, cyclomatic complexity, and GitHub Packages inventory across Azure DevOps and GitHub Enterprise",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-review",
    "dotnet",
    "nuget",
    "complexity",
    "azure-devops",
    "github-enterprise"
  ],
  "author": "Klemens Stelk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klemensms/mcp-consultant-tools.git",
    "directory": "packages/code-review"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@mcp-consultant-tools/core": "34.0.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.8.3",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.2.0",
    "glob": "^13.0.0",
    "semver": "^7.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/semver": "^7.7.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "bin": {
    "mcp-code-review": "build/index.js",
    "mcp-code-review-cli": "build/cli.js"
  }
}
