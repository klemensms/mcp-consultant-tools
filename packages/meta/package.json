{
  "name": "mcp-consultant-tools",
  "version": "35.0.0-beta.2",
  "description": "Complete MCP Consultant Tools package with all integrations: PowerPlatform, Azure DevOps, Azure Management, Figma, Application Insights, Log Analytics, Azure SQL, Service Bus, SharePoint, GitHub Enterprise, and Azure AD B2C",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "mcp-consultant-tools": "build/index.js",
    "mcp-tools-cli": "build/cli.js"
  },
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build *.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "powerplatform",
    "dynamics",
    "dataverse",
    "azure-devops",
    "figma",
    "application-insights",
    "log-analytics",
    "azure-sql",
    "sql-server",
    "service-bus",
    "sharepoint",
    "sharepoint-online",
    "github-enterprise",
    "azure-b2c",
    "identity",
    "telemetry",
    "monitoring",
    "crm"
  ],
  "author": "Michal Sobieraj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klemensms/mcp-consultant-tools.git",
    "directory": "packages/meta"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@mcp-consultant-tools/1password": "35.0.0-beta.1",
    "@mcp-consultant-tools/application-insights": "35.0.0-beta.1",
    "@mcp-consultant-tools/azure-b2c": "35.0.0-beta.1",
    "@mcp-consultant-tools/azure-data-factory": "35.0.0-beta.1",
    "@mcp-consultant-tools/azure-devops": "35.0.0-beta.1",
    "@mcp-consultant-tools/azure-devops-admin": "35.0.0-beta.2",
    "@mcp-consultant-tools/azure-management": "35.0.0-beta.1",
    "@mcp-consultant-tools/azure-sql": "35.0.0-beta.1",
    "@mcp-consultant-tools/azure-storage": "35.0.0-beta.1",
    "@mcp-consultant-tools/core": "34.0.0",
    "@mcp-consultant-tools/fabric": "35.0.0-beta.1",
    "@mcp-consultant-tools/figma": "35.0.0-beta.1",
    "@mcp-consultant-tools/github-enterprise": "35.0.0-beta.1",
    "@mcp-consultant-tools/log-analytics": "35.0.0-beta.1",
    "@mcp-consultant-tools/powerplatform": "35.0.0-beta.1",
    "@mcp-consultant-tools/powerplatform-customization": "35.0.0-beta.1",
    "@mcp-consultant-tools/powerplatform-data": "35.0.0-beta.1",
    "@mcp-consultant-tools/rest-api": "35.0.0-beta.1",
    "@mcp-consultant-tools/service-bus": "35.0.0-beta.1",
    "@mcp-consultant-tools/sharepoint": "35.0.0-beta.1",
    "@mcp-consultant-tools/teams": "35.0.0-beta.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2"
  }
}
