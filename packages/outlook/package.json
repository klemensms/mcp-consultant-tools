{
  "name": "@mcp-consultant-tools/outlook",
  "version": "35.0.0-beta.1",
  "description": "MCP server for Outlook mail as the signed-in user (device code) - read, search and download attachments, with drafts, send and delete behind off-by-default switches",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build *.tsbuildinfo",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "outlook",
    "microsoft-graph",
    "email",
    "microsoft365"
  ],
  "author": "Klemens Stelk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klemensms/mcp-consultant-tools.git",
    "directory": "packages/outlook"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@mcp-consultant-tools/core": "35.0.0-beta.2",
    "@mcp-consultant-tools/m365-core": "35.0.0-beta.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^14.0.3",
    "dompurify": "^3.2.3",
    "jsdom": "^26.0.0",
    "marked": "^17.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "bin": {
    "mcp-outlook": "build/index.js",
    "mcp-outlook-cli": "build/cli.js"
  }
}
