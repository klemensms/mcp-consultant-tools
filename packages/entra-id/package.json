{
  "name": "@mcp-consultant-tools/entra-id",
  "version": "35.0.0-beta.2",
  "description": "MCP server for Microsoft Entra ID - app registration audit, client secret and certificate expiry",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "entra-id",
    "microsoft-graph",
    "app-registration",
    "client-secret",
    "certificate-expiry",
    "security"
  ],
  "author": "Klemens Stelk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klemensms/mcp-consultant-tools.git",
    "directory": "packages/entra-id"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@mcp-consultant-tools/core": "34.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^14.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "bin": {
    "mcp-entra": "build/index.js",
    "mcp-entra-cli": "build/cli.js"
  }
}
