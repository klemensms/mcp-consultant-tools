{
  "name": "@mcp-consultant-tools/azure-sql",
  "version": "35.0.0-beta.2",
  "description": "MCP server for Azure SQL Database - queries, schema exploration, and optional write operations",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "sql",
    "database",
    "sql-server"
  ],
  "author": "Klemens Stelk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klemensms/mcp-consultant-tools.git",
    "directory": "packages/azure-sql"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@mcp-consultant-tools/core": "33.0.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^14.0.3",
    "mssql": "^11.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "bin": {
    "mcp-sql": "build/index.js",
    "mcp-sql-cli": "build/cli.js"
  }
}
