# --- npm integrity hashes (SHA-512 base64 in package-lock.json) ---
sha512-
# Bare base64 payload extracted from "integrity": "sha512-..." entries
# (86 chars = 512 bits / 6 bits-per-base64-char, with optional "==" padding)
^[A-Za-z0-9+/]{86}(==)?$

