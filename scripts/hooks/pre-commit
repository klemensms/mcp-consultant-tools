#!/bin/bash
# Pre-commit hook to scan for secrets before committing
# This helps prevent accidental credential exposure
#
# Install: ./scripts/install-hooks.sh
# Allowlists: .secret-scan-allowlist, .secret-scan-longstr-allowlist
#
# The allowlist files contain regex patterns (one per line) for known false
# positives. Lines starting with # are comments. Blank lines are ignored.

set -e

echo "🔐 Scanning for secrets..."

# Repo root (works even if committing from a subdirectory)
REPO_ROOT=$(git rev-parse --show-toplevel)
ALLOWLIST="$REPO_ROOT/.secret-scan-allowlist"
LONGSTR_ALLOWLIST="$REPO_ROOT/.secret-scan-longstr-allowlist"

# shellcheck source=../internal-scan-lib.sh
source "$REPO_ROOT/scripts/internal-scan-lib.sh"

# Check every pattern list before any scan reads it. One invalid line makes grep exit 2,
# the scan fed that list matches nothing, and the commit passes unscanned. This runs in
# the hook's own shell because a check inside $(...) cannot stop the commit.
BAD_LIST=0
for list in "$ALLOWLIST" "$LONGSTR_ALLOWLIST"; do
    check_pattern_list "$list" || BAD_LIST=1
done
check_internal_lists || BAD_LIST=1
if [ $BAD_LIST -eq 1 ]; then
    echo "🛑 BLOCKED: fix the pattern list line(s) above. While one is invalid, its whole list is off."
    exit 1
fi

# Files being committed (R: a renamed file can carry new content too)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Patterns to detect
SECRET_PATTERNS='(client_secret|CLIENT_SECRET|password|PASSWORD|api[_-]?key|API[_-]?KEY|secret_key|SECRET_KEY|private_key|PRIVATE_KEY)'

# Build allowlist filter command
# Strips comments and blank lines, then uses grep -vEf to exclude matches.
# Exit status is grep's: 0 = lines remain, 1 = none remain, 2 = grep failed.
filter_allowlist() {
    local allowfile="$1"
    if [ -f "$allowfile" ]; then
        grep -vEf <(grep -v '^#' "$allowfile" | grep -v '^$')
    else
        cat  # pass through if no allowlist
    fi
}

FOUND_SECRETS=0

# Files to exclude from scanning (the allowlists themselves contain keyword patterns)
EXCLUDE_FILES=".secret-scan-allowlist|.secret-scan-longstr-allowlist"

# Check staged content for secret keywords (excluding allowlisted patterns and excluded files)
KEYWORD_HITS=$(git diff --cached -- . ":(exclude).secret-scan-allowlist" ":(exclude).secret-scan-longstr-allowlist" | grep -iE "$SECRET_PATTERNS" | grep -v "^-" | grep -v "SECRET_PATTERNS" | filter_allowlist "$ALLOWLIST") || grep_ok $? "staged changes for secret keywords" || exit 1
if [ -n "$KEYWORD_HITS" ]; then
    echo "⚠️  WARNING: Potential secret keywords found in staged changes!"
    echo ""
    head -10 <<<"$KEYWORD_HITS"
    echo ""
    FOUND_SECRETS=1
fi

# Check for .claude/settings.json specifically
if grep -q ".claude/settings.json" <<<"$STAGED_FILES"; then
    echo "⚠️  WARNING: .claude/settings.json is staged for commit!"
    echo "   This file may contain command patterns with embedded secrets."
    echo "   Please verify it does not contain credentials."
    echo ""
    FOUND_SECRETS=1
fi

# Check for .env files (hard block - never allow)
# Allow template/example files (.env.example, .env.template, .env.sample, .env.dist).
ENV_FILES=$(echo "$STAGED_FILES" | grep -E "\.env($|\.)" | grep -vE "\.env\.(example|template|sample|dist)$" || true)
if [ -n "$ENV_FILES" ]; then
    echo "❌ ERROR: .env file is staged for commit!"
    echo "   Environment files should NEVER be committed."
    echo "   Offending files:"
    echo "$ENV_FILES" | sed 's/^/     /'
    exit 1
fi

# Check for long strings that look like credentials (excluding allowlisted patterns and excluded files)
# package-lock.json is excluded - it contains sha512 integrity hashes by design
# (npm-managed, not a credential vector).
LONG_STRINGS=$(git diff --cached -- . ":(exclude).secret-scan-allowlist" ":(exclude).secret-scan-longstr-allowlist" ":(exclude)package-lock.json" ":(exclude)**/package-lock.json" | grep -oE '[a-zA-Z0-9+/~]{35,}' | grep -v "^-" | filter_allowlist "$LONGSTR_ALLOWLIST") || grep_ok $? "staged changes for long strings" || exit 1
if [ -n "$LONG_STRINGS" ]; then
    echo "⚠️  WARNING: Long strings detected (possible credentials):"
    head -5 <<<"$LONG_STRINGS"
    echo ""
    FOUND_SECRETS=1
fi

# ─── Internal-identifier scan (client/internal info, not secrets) ──────────
# Unlike the secret scan above, denylist hits are NEVER false positives and
# must NOT be bypassed with --no-verify. See CLAUDE.md → "Public Repo Hygiene".
ADDED_LINES=$(git diff --cached -- . ":(exclude).secret-scan-allowlist" ":(exclude).secret-scan-longstr-allowlist" ":(exclude).internal-scan-placeholders" ":(exclude)package-lock.json" ":(exclude)**/package-lock.json" | grep '^+' | grep -v '^+++' || true)
if [ -n "$ADDED_LINES" ]; then
    if ! printf '%s\n' "$ADDED_LINES" | internal_scan "staged changes"; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "🛑 BLOCKED: internal/client identifier in staged changes."
        echo "   This is a PUBLIC repo. Do NOT bypass with --no-verify."
        echo "   Replace the value with a sanctioned placeholder"
        echo "   (CLAUDE.md → Public Repo Hygiene), then re-stage."
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        exit 1
    fi
fi

if [ $FOUND_SECRETS -eq 1 ]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🛑 REVIEW REQUIRED: Potential secrets detected above."
    echo ""
    echo "   To proceed anyway (if these are false positives):"
    echo "   git commit --no-verify"
    echo ""
    echo "   To add false positives to allowlist:"
    echo "   Edit .secret-scan-allowlist or .secret-scan-longstr-allowlist"
    echo ""
    echo "   To abort and fix:"
    echo "   git reset HEAD <file>"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    exit 1
fi

echo "✅ No obvious secrets detected."
exit 0
